        <mxCell id="fact_sales" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=8;spacingTop=5;fontStyle=1;" value="&lt;b&gt;FACT_SALES&lt;/b&gt;&lt;hr&gt;Grain: one row per sales order line&lt;br&gt;&lt;br&gt;PK: sales_line_key&lt;br&gt;FK: order_date_key&lt;br&gt;FK: due_date_key&lt;br&gt;FK: ship_date_key&lt;br&gt;FK: product_key&lt;br&gt;FK: customer_key&lt;br&gt;FK: ship_to_geography_key&lt;br&gt;FK: bill_to_geography_key&lt;br&gt;FK: credit_card_key&lt;br&gt;FK: salesperson_key&lt;br&gt;FK: territory_key&lt;br&gt;&lt;br&gt;Degenerate: salesorderid, salesorderdetailid&lt;br&gt;Attributes: order_status_code&lt;br&gt;&lt;br&gt;Measures:&lt;br&gt;order_quantity&lt;br&gt;gross_sales_amount&lt;br&gt;discount_amount&lt;br&gt;net_sales_amount&lt;br&gt;" vertex="1">
