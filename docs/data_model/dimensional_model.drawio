        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;" value="Adventure Works Analytics&lt;br&gt;Conceptual Dimensional Model" vertex="1">
