        <mxCell id="bridge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=8;spacingTop=5;" value="&lt;b&gt;BRIDGE_ORDER_SALES_REASON&lt;/b&gt;&lt;hr&gt;Grain: one row per order/reason association&lt;br&gt;&lt;br&gt;FK: salesorderid (degenerate order identifier)&lt;br&gt;FK: sales_reason_key&lt;br&gt;&lt;br&gt;Preserves the order-to-reason&lt;br&gt;many-to-many relationship" vertex="1">
